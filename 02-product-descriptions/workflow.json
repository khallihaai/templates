            },
            {
              "id": "m3",
              "name": "المميزات",
              "type": "string",
              "value": "={{ $('البرومبت (التعليمات)').item.json[\"المميزات\"] }}"
            },
            {
              "id": "m4",
              "name": "السعر",
              "type": "string",
              "value": "={{ $('البرومبت (التعليمات)').item.json[\"السعر\"] }}"
            },
            {
              "id": "m5",
              "name": "الوصف (عربي)",
              "type": "string",
              "value": "={{ $('الوصف بالعربية (Ollama)').item.json.message.content }}"
            },
            {
              "id": "m6",
              "name": "Description (EN)",
              "type": "string",
              "value": "={{ $json.message.content }}"
            }
          ]
        },
        "options": {}
