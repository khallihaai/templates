      "id": "0fe07091-2fcc-4746-9c91-3ff1ea1cccf5",
      "name": "استخرج صفوف الإكسل",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.1,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "p1",
              "name": "system",
              "type": "string",
              "value": "أنت كاتب إعلانات لمتجر عربي على الإنترنت. مهمتك كتابة وصف تسويقي قصير للمنتج.\nالتزم بهذه القواعد:\n١. اكتب جملتين أو ثلاث جمل فقط، بعربية فصحى سليمة نحوياً ومفهومة في الخليج والشام، وبالعربية وحدها دون أي كلمة إنجليزية داخل الجملة.\n٢. استعمل فقط المعلومات المذكورة. لا تضف أي ميزة أو رقم أو مكوّن غير موجود.\n٣. ابدأ بفائدة تهمّ العميل، ثم اذكر أبرز ميزة، وأنهِ بدعوة واضحة للشراء مثل: اطلبه الآن.\n٤. لهجة بائع واثق وصادق، بلا مبالغة ولا تكرار ولا وعود مطلقة.\n٥. أعِد الوصف فقط: نصاً عادياً بلا عناوين ولا نقاط ولا رموز."
            },
            {
              "id": "p2",
              "name": "prompt",
              "type": "string",
              "value": "=المنتج: {{ $json[\"الاسم\"] }}\nالفئة: {{ $json[\"الفئة\"] }}\nالمميزات: {{ $json[\"المميزات\"] }}\nالسعر: {{ $json[\"السعر\"] }}"
            },
            {
              "id": "p3",
              "name": "system_en",
              "type": "string",
              "value": "You are a copywriter for an Arabic online store. Write a short English product description.\nRules: exactly 2 short sentences. Use only the given facts; invent nothing. Keep the brand/product name transliterated (do not translate it). Mention the price only if given. Confident, honest seller tone. Return the description only, as plain text."
            },
            {
              "id": "p4",
              "name": "prompt_en",
              "type": "string",
              "value": "=Product: {{ $json[\"الاسم\"] }}\nCategory: {{ $json[\"الفئة\"] }}\nFeatures: {{ $json[\"المميزات\"] }}\nPrice: {{ $json[\"السعر\"] }}"
            }
          ]
        },
        "options": {}
      },
      "id": "0454ee00-e815-4be6-957d-e0b265eef9af",
      "name": "البرومبت (التعليمات)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        940,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:11434/api/chat",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: \"qwen3:8b\", stream: false, think: false, options: { temperature: 0.5, top_p: 0.8, num_predict: 220 }, messages: [ { role: \"system\", content: $json.system }, { role: \"user\", content: $json.prompt } ] }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "b0536c30-1a35-4041-98ef-67f0d14ade1a",
      "name": "الوصف بالعربية (Ollama)",
      "type": "n8n-nodes-base.httpRequest",
