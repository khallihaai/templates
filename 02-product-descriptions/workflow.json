      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:11434/api/chat",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: \"qwen3:8b\", stream: false, think: false, options: { temperature: 0.5, top_p: 0.8, num_predict: 220 }, messages: [ { role: \"system\", content: $('البرومبت (التعليمات)').item.json.system_en }, { role: \"user\", content: $('البرومبت (التعليمات)').item.json.prompt_en } ] }) }}",
        "options": {
          "timeout": 120000
        }
      },
