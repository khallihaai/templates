      "id": "283bed38-2d62-4f85-a398-de9eac55fc64",
      "name": "استخرج نص الـPDF",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.1,
      "position": [
        910,
        300
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "p1",
              "name": "system",
              "type": "string",
              "value": "أنت مساعد متخصص في تلخيص التقارير. مهمتك تلخيص التقرير التالي في صفحة واحدة بالعربية الفصحى.\nالتزم بهذه القواعد:\n١. ابدأ بعنوان «# ملخص التقرير»، ثم قسم «## ملخص تنفيذي» من ثلاث إلى أربع جُمل.\n٢. ثم قسم «## أهم النقاط» على شكل نقاط موجزة من أربع إلى ست نقاط.\n٣. إن تضمّن التقرير توصيات أو خطوات تالية، أضِف قسم «## التوصيات» بنقاط قصيرة.\n٤. استخدم فقط ما ورد في التقرير، ولا تُضف أي رقم أو معلومة غير موجودة، واحتفظ بالأرقام كما هي.\n٥. لغة عربية واضحة ومهنية، بلا حشو ولا تكرار، وبلا أي كلمة إنجليزية داخل الجُمل.\n٦. أعِد الملخص فقط بصيغة ماركداون، دون أي شرح إضافي قبله أو بعده."
            },
            {
              "id": "p2",
              "name": "prompt",
              "type": "string",
              "value": "=لخّص هذا التقرير في صفحة واحدة. النص المستخرج من التقرير (ملف: {{ $json.file }}):\n\n{{ $json.text.slice(0, 6000) }}"
            }
          ]
        },
        "options": {}
      },
      "id": "10d8c26e-2f8c-4b07-969a-d641580559f3",
      "name": "البرومبت (التعليمات)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1140,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:11434/api/chat",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: \"qwen3:8b\", stream: false, think: false, options: { temperature: 0.3, top_p: 0.9, num_predict: 800, num_ctx: 8192 }, messages: [ { role: \"system\", content: $json.system }, { role: \"user\", content: $json.prompt } ] }) }}",
        "options": {
          "timeout": 180000
        }
      },
      "id": "73e77682-d336-467d-b907-d2fcf2b6dae5",
      "name": "لخّص بالذكاء الاصطناعي (Ollama)",
