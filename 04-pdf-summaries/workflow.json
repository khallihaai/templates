        "options": {}
      },
      "id": "65c98e81-632b-47f7-8293-5abdb4b0b21f",
      "name": "اقرأ ملفات التقارير",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1.1,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
