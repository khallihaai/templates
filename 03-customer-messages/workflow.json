              "type": "number",
              "value": "={{ $('البرومبت (التعليمات)').item.json[\"الرقم\"] }}"
            },
            {
              "id": "r1",
              "name": "الرسالة",
              "type": "string",
              "value": "={{ $('البرومبت (التعليمات)').item.json[\"الرسالة\"] }}"
            },
            {
              "id": "r2",
              "name": "التصنيف",
              "type": "string",
              "value": "={{ JSON.parse($json.message.content).category }}"
            },
            {
              "id": "r3",
              "name": "الأولوية",
              "type": "string",
              "value": "={{ JSON.parse($json.message.content).urgency }}"
            },
            {
              "id": "r4",
              "name": "الرد المقترح",
              "type": "string",
              "value": "={{ JSON.parse($json.message.content).reply }}"
            },
            {
              "id": "r5",
              "name": "cat_rank",
              "type": "number",
              "value": "={{ ({'طلب':1,'شكوى':2,'سؤال':3,'أخرى':4})[JSON.parse($json.message.content).category] || 9 }}"
            },
            {
              "id": "r6",
              "name": "urg_rank",
              "type": "number",
              "value": "={{ JSON.parse($json.message.content).urgency === 'عاجل' ? 1 : 2 }}"
            }
          ]
